# Backend configuration (development defaults)
# IMPORTANT: Override secrets in production.

# Database URL (default requested by task)
DATABASE_URL=sqlite:///app.db

# JWT signing secret (development only default requested by task)
JWT_SECRET=mobilecare_secret

# Bind address/port for preview/dev
HOST=0.0.0.0
PORT=3001

# Optional: control token lifetime in minutes (default 1440)
JWT_TTL_MINUTES=1440

# Optional SQLite fallback if DATABASE_URL is not set (used only if DATABASE_URL is empty)
SQLITE_PATH=app.db
