# Backend configuration
# Required for auth (JWT signing). Set a strong random value in production.
JWT_SECRET=change-me

# Optional: control token lifetime in minutes (default 1440)
JWT_TTL_MINUTES=1440

# Database connection (preferred)
# Example (Postgres): postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=

# Optional SQLite fallback if DATABASE_URL is not set
# Use a relative file or an absolute path.
SQLITE_PATH=mobile_service.db
